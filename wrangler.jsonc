{
  // Snicksnack-mottagaren. Den här filen pekar på Mattias egen installation (kontot mattias, snicksnackserver.applicerad.ai).
  // För en egen: byt account_id, routes och database_id (från `wrangler d1 create`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snicksnack-mottagare",
  "account_id": "34b3ff26c4be7161a843f6798c2b5f61",
  "routes": [{ "pattern": "snicksnackserver.applicerad.ai", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Största kropp i byte. Workers tar högst 100 MB på gratis- och Pro-planen.
    "MAX_BYTES": "104857600",
    // Största kropp för summarize och chat (transcript.json), i byte.
    "AI_MAX_BYTES": "20971520"
  },
  "r2_buckets": [
    { "binding": "FILER", "bucket_name": "snicksnack-mottagare" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snicksnack-mottagare",
      "database_id": "b3df0bc2-c680-4ce7-b4e5-c52ed8a70c7e",
      "migrations_dir": "migrations"
    }
  ]
}
