{
  "name": "snicksnack-mottagare",
  "version": "1.0.0",
  "description": "Öppen referensmottagare för Snicksnack som Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev --local-upstream=localhost:8787",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed": "node scripts/seed.mjs"
  },
  "author": "Mattias Ahlström",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "typescript": "^5.9.3",
    "vitest": "4.1",
    "wrangler": "^4.151.1"
  },
  "private": true
}
